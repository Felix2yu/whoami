{{define "content"}}
<main>
<table class="kv rows"><tbody>{{range .Rows}}
  <tr>
    <th>{{.Title}}</th>
    <td><span class="v" title="{{.Value}}">{{.Value}}</span>{{if .Detail}}<span class="muted"> · {{.Detail}}</span>{{end}}{{- if $.Detail}}
      {{- if .Sources}}
      <p class="muted">来源：{{$first := true}}{{range .Sources}}{{if $first}}{{$first = false}}{{else}} + {{end}}{{.}}{{end}}</p>
      {{- end}}{{range .Notes}}
      <p class="muted">{{.}}</p>
      {{- end}}{{if .Evidence}}
      <details><summary>原始证据</summary>
        <table class="kv"><tbody>{{range .Evidence}}
          <tr><th>{{.Key}}</th><td>{{.Raw}}{{if .Truncated}}<em class="cut">已截断</em>{{end}}</td></tr>{{end}}
        </tbody></table>
      </details>
      {{- end}}
    {{- end}}
    </td>
  </tr>{{end}}
</tbody></table>

<p class="actions"><button type="button" class="copybtn" title="复制结论摘要，便于贴进工单或聊天">复制结论</button></p>
{{- if .Detail}}
{{- if .JSStatus}}
<p class="muted">{{.JSStatus}}</p>
{{- end}}
{{- if .Evidence}}
<details class="more"><summary>本次请求的原始证据（{{len .Evidence}} 条）</summary>
  <table class="kv"><tbody>{{range .Evidence}}
    <tr><th>{{.Key}}</th><td>{{.Raw}}{{if .Truncated}}<em class="cut">已截断</em>{{end}}</td></tr>{{end}}
  </tbody></table>
</details>
{{- end}}
{{- end}}
</main>
{{end}}
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>访客设备信息</title>
<link rel="stylesheet" href="/static/app.css">
</head>
<body class="{{if .Compact}}compact{{end}}">

<header class="head">
  <h1>访客设备信息</h1>
</header>

<div id="report">{{template "content" .}}</div>

<footer>
  {{if .Detail}}<p>结论由请求头与浏览器端回报推断，可被 DevTools 或代理伪造，仅供自助排查与终端盘点，不作为准入依据。</p>{{end}}
  <p class="muted">记录 ID {{.Result.ID}} · {{.Result.Time.Format "2006-01-02 15:04:05"}} UTC</p>
</footer>

<script src="/static/detect.js" defer></script>
</body>
</html>
